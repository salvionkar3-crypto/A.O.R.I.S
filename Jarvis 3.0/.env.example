# ==============================================================================
# Project A.O.R.I.S. — Multi-Model AI Orchestration System
# APEX LEGENDS | Nebius × NVIDIA Global AI Hackathon 2026
#
# Copy this file to .env and adjust as needed. NEVER commit .env to version control.
# ==============================================================================

# Application Environment & Cloud Hosting
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Cloud Security & Access Control
# Set a secret key to protect public Web API & private memories in production:
# (If unset, A.O.R.I.S. operates in open development mode)
JARVIS_API_KEY=your_secret_access_key_here

# Restrictive CORS origins (comma-separated or JSON list in production, e.g. ["https://my-aoris.onrender.com"])
JARVIS_CORS_ORIGINS=["*"]

# Rate Limiting & DoS Protection
JARVIS_RATE_LIMIT_PER_MINUTE=60
JARVIS_MAX_REQUEST_SIZE_BYTES=10485760

# Storage & Memory Engine Configuration (Set JARVIS_DATA_DIR to persistent mount like /var/data)
JARVIS_DATA_DIR=data
JARVIS_DB_PATH=data/jarvis.db
AORIS_DOCS_DIR=data/generated_docs
JARVIS_MEMORY_MAX_RETRIEVAL_RESULTS=5
JARVIS_MEMORY_SIMILARITY_THRESHOLD=0.3
JARVIS_ENABLE_SOFT_DELETE=true

# ==============================================================================
# Primary AI Provider: Nebius Token Factory with an Eligible NVIDIA Open Model
# Foundation Orchestrator & Final Synthesis Model
# ==============================================================================
# Set your Nebius API Key to activate live inference:
NEBIUS_API_KEY=your_nebius_api_key_here

# Base URL for Nebius Token Factory OpenAI-compatible API:
# Options:
#   https://api.tokenfactory.nebius.com/v1
#   https://api.tokenfactory.us-central1.nebius.com/v1
#   https://api.studio.nebius.ai/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Eligible NVIDIA Open Model on Nebius Token Factory:
# Options:
#   nebius/nvidia/nemotron-3-super-120b-a12b   (Default 120B hybrid MoE reasoning model)
#   nebius/nvidia/Nemotron-3-Ultra-550b-a55b  (Frontier 550B hybrid MoE model)
#   nebius/nvidia/Nemotron-3_5-Lightning      (High-throughput efficient variant)
#   nvidia/nemotron-4-340b-instruct           (Open synthetic data & reasoning model)
NEBIUS_DEFAULT_MODEL=nebius/nvidia/nemotron-3-super-120b-a12b

# ==============================================================================
# Secondary / Alternative Provider: Direct NVIDIA NIM Endpoint
# ==============================================================================
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-4-340b-instruct

# ==============================================================================
# Specialist Provider 1: OpenAI (Reasoning & Deep Analysis)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Specialist Provider 2: Anthropic (Code & Technical Engineering)
# ==============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==============================================================================
# Specialist Provider 3: Google (Multimodal Vision & Creative Assets)
# ==============================================================================
# Either GOOGLE_API_KEY or GEMINI_API_KEY is accepted:
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash

